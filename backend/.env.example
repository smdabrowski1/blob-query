# Copy this file to .env and fill in your key: cp .env.example .env

# Required for the "Ask AI" natural-language SQL tab. Without this set, that
# tab shows a "not configured" message but the rest of the app works fine.
#
# Get a key: https://console.anthropic.com/settings/keys
#   1. Sign in / create an Anthropic account.
#   2. Settings -> API Keys -> Create Key.
#   3. Paste it below (no quotes needed).
ANTHROPIC_API_KEY=

# Optional: which Claude model generates the SQL. Defaults to claude-sonnet-5
# if unset. Uncomment to override (e.g. a cheaper/faster model):
# ANTHROPIC_MODEL=claude-haiku-4-5
